# ==============================================================================
# VocalRemover.group Multi-Provider Environment Configuration
# ==============================================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=https://vocalremover.group

# Admin Security Key (used for Admin Dashboard API authentication)
ADMIN_SECRET_KEY=generate_a_secure_random_64_char_admin_key

# Storage Signing Key (HMAC-SHA256 signature for time-limited stem downloads)
STORAGE_SIGNING_KEY=generate_a_secure_random_64_char_signing_key

# ------------------------------------------------------------------------------
# Provider 1: SplitBeat (RapidAPI)
# Endpoint: https://splitbeat-vocal-remover-music-splitter.p.rapidapi.com/Upload_audio
# ------------------------------------------------------------------------------
SPLITBEAT_ENABLED=true
SPLITBEAT_PRIORITY=1
SPLITBEAT_RAPIDAPI_HOST=splitbeat-vocal-remover-music-splitter.p.rapidapi.com
SPLITBEAT_RAPIDAPI_KEY=your_splitbeat_rapidapi_key_here
# Optional plan limits (leave empty/unset for plan-default/unlimited)
# SPLITBEAT_DAILY_QUOTA=
# SPLITBEAT_MONTHLY_QUOTA=

# ------------------------------------------------------------------------------
# Provider 2: Voice Separation API (RapidAPI)
# Endpoint: https://voice-separation-api.p.rapidapi.com/api/rapidapi/separate-audio
# ------------------------------------------------------------------------------
VOICE_SEPARATION_ENABLED=true
VOICE_SEPARATION_PRIORITY=2
VOICE_SEPARATION_RAPIDAPI_HOST=voice-separation-api.p.rapidapi.com
VOICE_SEPARATION_RAPIDAPI_KEY=your_voice_separation_rapidapi_key_here
# Optional plan limits (leave empty/unset for plan-default/unlimited)
# VOICE_SEPARATION_DAILY_QUOTA=
# VOICE_SEPARATION_MONTHLY_QUOTA=

# ------------------------------------------------------------------------------
# Provider 3: Disband (disband.io)
# Base URL: https://api.disband.io/v1
# ------------------------------------------------------------------------------
DISBAND_ENABLED=true
DISBAND_PRIORITY=3
DISBAND_BASE_URL=https://api.disband.io/v1
DISBAND_KEY=your_disband_bearer_token_here
# Quota is fetched live from Disband GET /usage endpoint

# ------------------------------------------------------------------------------
# Provider 4: Karadeo (karadeo.com)
# Endpoint: https://karadeo.com/api/vocal-remover
# Requires public fileUrl (handled via secure signed temporary endpoint)
# ------------------------------------------------------------------------------
KARADEO_ENABLED=true
KARADEO_PRIORITY=4
KARADEO_ENDPOINT=https://karadeo.com/api/vocal-remover
KARADEO_API_KEY=your_karadeo_api_key_here
# Optional plan limits (leave empty/unset for plan-default/unlimited)
# KARADEO_DAILY_QUOTA=
# KARADEO_MONTHLY_QUOTA=

# ------------------------------------------------------------------------------
# Provider 5: StemConsole (stemconsole.ai)
# Documentation: https://stemconsole.ai/developers/
# Free Plan: 5 songs monthly
# ------------------------------------------------------------------------------
STEMCONSOLE_ENABLED=true
STEMCONSOLE_PRIORITY=5
STEMCONSOLE_BASE_URL=https://api.stemconsole.ai/v1
STEMCONSOLE_API_KEY=your_stemconsole_api_key_here
# Optional plan limits (leave empty/unset to use dynamic provider plan status)
# STEMCONSOLE_MONTHLY_QUOTA=

# ------------------------------------------------------------------------------
# Provider 6: AudioShake (Standby / Future Provider)
# Keep disabled until contract & credentials are confirmed
# ------------------------------------------------------------------------------
AUDIOSHAKE_ENABLED=false
AUDIOSHAKE_PRIORITY=10
AUDIOSHAKE_API_KEY=your_audioshake_api_key_here

# ------------------------------------------------------------------------------
# Excluded APIs (Do NOT enable for vocal separation):
# - Cat Meowing API
# - Cat Translator API
# - StemSplit YouTube jobs
# - AI Music Generator status
# ------------------------------------------------------------------------------
